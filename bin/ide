#!/usr/bin/env -S uv run --quiet --python 3.14 --script
# /// script
# dependencies = ["iterm2; sys_platform == 'darwin'"]
# ///
# ide [agent] [args...] : bố cục kiểu IDE quanh khung đang đứng
#   ┌──────────────┬─────────────┐
#   │ agent        │ preview     │   ide          → chỉ mở preview (gõ `! ide` trong Claude/Codex)
#   │              │ (trình duyệt│   ide claude   → mở preview rồi chạy claude ở khung chính
#   │              │  iTerm2)    │   ide ccy / ide cxy / ide --help  (ide --help vi)
#   └──────────────┴─────────────┘
# Preview là khung trình duyệt của iTerm2 (bin/pv): danh sách file thư mục, bấm video/ảnh là phát.
# Đổi nội dung bằng `pv <file|url|thư mục>`, đóng bằng `pvx`. Windows Terminal không có trình duyệt
# trong khung nên chỉ chạy agent. Terminal.app hay iTerm2 chưa có plugin trình duyệt cũng vậy.
import os, shlex, shutil, signal, subprocess, sys

# Thêm lệnh mới: tên gõ → (lệnh chạy, màu tab, giải thích EN, giải thích VN)
C, X, G = "D97757", "10A37F", "4285F4"
AGENTS = {
    "claude": ("claude", C, "Claude Code, asks before risky actions", "Claude Code, hỏi trước khi làm việc rủi ro"),
    "cc": ("claude", C, "same as claude", "giống claude"),
    "ccy": ("claude --dangerously-skip-permissions", C, "never asks; full trust, use in repos you can reset",
            "không hỏi gì cả; chỉ dùng ở repo khôi phục được"),
    "cca": ("claude --permission-mode auto", C, "auto mode: a classifier approves safe actions, asks on risky ones",
            "tự duyệt việc an toàn, vẫn hỏi việc nguy hiểm"),
    "cce": ("claude --permission-mode acceptEdits", C, "auto-accept file edits, still asks for shell commands",
            "tự nhận sửa file, lệnh shell vẫn hỏi"),
    "ccp": ("claude --permission-mode plan", C, "plan mode: reads and plans, changes nothing until you approve",
            "chỉ đọc và lên kế hoạch, duyệt rồi mới sửa"),
    "ccc": ("claude --continue", C, "continue the last conversation in this folder", "tiếp cuộc trò chuyện gần nhất ở thư mục này"),
    "ccr": ("claude --resume", C, "pick an older conversation to resume", "chọn cuộc trò chuyện cũ để mở lại"),
    "ccw": ("claude --worktree", C, "work in a fresh git worktree, your branch stays clean",
            "làm trong git worktree mới, nhánh đang dùng không bị đụng"),
    "codex": ("codex", X, "Codex CLI, default approvals", "Codex CLI, duyệt mặc định"),
    "cx": ("codex", X, "same as codex", "giống codex"),
    "cxa": ("codex --approve-for-me", X, "auto-review approvals inside the workspace sandbox",
            "tự duyệt trong sandbox của thư mục làm việc"),
    "cxy": ("codex --dangerously-bypass-approvals-and-sandbox", X, "no approvals and no sandbox; full trust",
            "không hỏi, không sandbox; tin hoàn toàn"),
    "cxr": ("codex resume --last", X, "continue the last Codex session", "tiếp phiên Codex gần nhất"),
    "agy": ("agy", G, "Antigravity CLI", "Antigravity CLI"),
    "agyy": ("agy --dangerously-skip-permissions", G, "Antigravity, auto-approve every tool", "Antigravity, tự duyệt mọi công cụ"),
    "agyc": ("agy --continue", G, "continue the last Antigravity conversation", "tiếp cuộc trò chuyện agy gần nhất"),
    "gemini": ("gemini", G, "Gemini CLI", "Gemini CLI"),
    "opencode": ("opencode", "E5B567", "opencode", "opencode"),
    "aider": ("aider", "7FB8B0", "aider", "aider"),
    "copilot": ("copilot", "C792B8", "GitHub Copilot CLI", "GitHub Copilot CLI"),
    "cursor": ("cursor-agent", "CFCAC3", "Cursor agent CLI", "Cursor agent CLI"),
}
name, rest = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
if name in ("-h", "--help"):
    vi = rest[:1] == ["vi"]
    print("dùng: ide [lệnh] [tham số thêm...]   (ide --help = English)" if vi else
          "usage: ide [preset] [extra args...]   (ide --help vi = tiếng Việt)")
    print("  ide              " + ("chỉ mở khung preview bên phải" if vi else "only open the preview pane on the right"))
    for k, (cmd, _, en, vn) in AGENTS.items():
        print(f"  ide {k:<9} {cmd:<48} {vn if vi else en}")
    sys.exit(0)
if name and name not in AGENTS:
    sys.exit(f"ide: không biết '{name}'. Có: {', '.join(AGENTS)}")
color = AGENTS[name][1] if name else ("D97757" if os.environ.get("CLAUDECODE") else "")


def iterm():
    import iterm2
    sid = os.environ["ITERM_SESSION_ID"].split(":")[-1]

    async def main(conn):
        app = await iterm2.async_get_app(conn)
        me = app.get_session_by_id(sid)
        tab = me.tab
        if color:
            p = iterm2.LocalWriteOnlyProfile()
            p.set_tab_color(iterm2.Color(*(int(color[i:i + 2], 16) for i in (0, 2, 4))))
            p.set_use_tab_color(True)
            for s in tab.sessions:
                await s.async_set_profile_properties(p)
        await me.async_activate()

    iterm2.run_until_complete(main)


# khung preview cần iTerm2 + plugin trình duyệt của nó; terminal khác chỉ chạy agent (theme, status line vẫn dùng được)
PLUGIN = [os.path.expanduser("~/Applications/iTermBrowserPlugin.app"), "/Applications/iTermBrowserPlugin.app"]
preview = bool(os.environ.get("ITERM_SESSION_ID")) and any(map(os.path.exists, PLUGIN))
pv = os.path.join(os.path.dirname(os.path.realpath(__file__)), "pv")
if preview:
    subprocess.run([pv, "."], stdout=subprocess.DEVNULL)  # pv tự đóng preview cũ của khung này
elif os.environ.get("ITERM_SESSION_ID"):
    print("ide: chưa có plugin trình duyệt của iTerm2 nên không mở preview "
          "(mở 1 profile kiểu Browser, iTerm2 sẽ hiện thông báo \"Browser Plugin Missing\" kèm nút tải)", file=sys.stderr)
elif not name:
    sys.exit("ide: khung preview chỉ có trong iTerm2 (cần plugin trình duyệt). Ở terminal này dùng `ide <agent>` để chạy agent.")
if os.environ.get("ITERM_SESSION_ID"):
    iterm()

if name:
    cmd = [*shlex.split(AGENTS[name][0]), *rest]
    if os.name == "nt":
        sys.exit(subprocess.run([shutil.which(cmd[0]) or cmd[0], *cmd[1:]]).returncode)
    # chạy agent như tiến trình con (không exec) để khi agent thoát thì đóng luôn khung preview
    signal.signal(signal.SIGINT, signal.SIG_IGN)  # Ctrl+C là của agent, ide chỉ chờ
    try:
        code = subprocess.run(cmd).returncode
    except FileNotFoundError:
        sys.exit(f"ide: chưa cài {cmd[0]}")
    finally:
        if preview:
            subprocess.run([pv, "-x"])
    sys.exit(code)
