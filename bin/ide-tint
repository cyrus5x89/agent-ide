#!/usr/bin/env python3
# ide-tint <effort> [--transcript PATH] : đổi màu nhấn của khung iTerm2 theo mức effort, in ra dãy ngọc rồng cho status line
#   effort: low | medium | high | xhigh | max (prompt có chữ "ultracode" → ultracode)
#   Đổi: con trỏ, tab, vùng chọn, link, màu vàng/xanh/tím/lục lam (từ khoá, chuỗi trong code). Giữ nền đen, giữ đỏ/xanh lá cho diff.
#   Chạy nhanh (chỉ stdlib); khi mức effort đổi mới gọi iTerm2 API ở tiến trình nền.
import json, os, subprocess, sys

# mức → (số ngọc, màu nhấn)
LEVELS = {
    "low": (1, "F2C230"), "medium": (2, "C98A0B"), "high": (3, "FFD84D"),
    "xhigh": (4, "E0384F"), "max": (5, "2FA8F0"), "ultracode": (7, "D8DEE9"),
}
BALL = "F5A623"
# màu gốc của theme Claude IDE Dragonball: ô ANSI → hex
BASE = {3: "E5B567", 4: "7AA2C9", 5: "C792B8", 6: "7FB8B0", 11: "F0C987", 12: "96BAE0", 13: "D9A9CC", 14: "9ACCC4"}


def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(rgb(a), rgb(b)))


def ultracode(transcript):
    # prompt gần nhất của người dùng có chữ ultracode không
    try:
        with open(transcript, "rb") as fh:
            fh.seek(max(0, os.path.getsize(transcript) - 262144))
            lines = fh.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return False
    for line in reversed(lines):
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        msg = obj.get("message") or {}
        if obj.get("type") != "user" or msg.get("role") != "user":
            continue
        content = msg.get("content")
        if isinstance(content, list):
            if any(isinstance(c, dict) and c.get("type") == "tool_result" for c in content):
                continue
            content = " ".join(c.get("text", "") for c in content if isinstance(c, dict))
        if isinstance(content, str) and not content.lstrip().startswith("<"):
            return "ultracode" in content.lower()
    return False


def balls(level):
    n, accent = LEVELS[level]
    on = "".join(f"\033[38;2;{';'.join(map(str, rgb(BALL)))}m●" for _ in range(n))
    off = "\033[2m" + "○" * (7 - n) if n < 7 else ""
    return f"{on}{off}\033[0m"


def apply(level, sid):
    import iterm2
    _, accent = LEVELS[level]

    async def main(conn):
        app = await iterm2.async_get_app(conn)
        s = app.get_session_by_id(sid)
        if not s:
            return
        p = iterm2.LocalWriteOnlyProfile()
        c = lambda t: iterm2.Color(*t)
        p.set_cursor_color(c(rgb(accent)))
        p.set_link_color(c(rgb(accent)))
        p.set_selection_color(c(mix("0E0E0E", accent, 0.35)))
        p.set_tab_color(c(rgb(accent)))
        p.set_use_tab_color(True)
        for slot, base in BASE.items():
            getattr(p, f"set_ansi_{slot}_color")(c(mix(base, accent, 0.6)))
        await s.async_set_profile_properties(p)

    iterm2.run_until_complete(main)


if __name__ == "__main__":
    if sys.argv[1:2] == ["--apply"]:
        apply(sys.argv[2], sys.argv[3])
        sys.exit(0)
    args = sys.argv[1:]
    level = (args[0] if args else "").lower()
    if "--transcript" in args and ultracode(args[args.index("--transcript") + 1]):
        level = "ultracode"
    if level not in LEVELS:
        sys.exit(0)
    print(balls(level), end="")
    sid = os.environ.get("ITERM_SESSION_ID", "").split(":")[-1]
    if not sid:
        sys.exit(0)
    cache = os.path.expanduser(f"~/.cache/ide-tint/{sid}")
    try:
        with open(cache) as fh:
            if fh.read() == level:
                sys.exit(0)
    except OSError:
        pass
    os.makedirs(os.path.dirname(cache), exist_ok=True)
    with open(cache, "w") as fh:
        fh.write(level)
    subprocess.Popen(["uv", "run", "--quiet", "--python", "3.14", "--with", "iterm2", "python", os.path.realpath(__file__),
                      "--apply", level, sid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
