#!/usr/bin/env python3
# ide-tint <effort> [--model NAME] [--transcript PATH] [--with-level] : đổi màu nhấn của khung iTerm2 theo mức effort, in ra icon ngọc rồng 1-7 sao (❶-❼) cho status line
#   effort: low | medium | high | xhigh | max (prompt có chữ "ultracode" → ultracode)
#   Đổi: con trỏ, tab, vùng chọn, link, màu vàng/xanh/tím/lục lam (từ khoá, chuỗi trong code). Giữ nền đen, giữ đỏ/xanh lá cho diff.
#   Chạy nhanh (chỉ stdlib); khi mức effort đổi mới gọi iTerm2 API ở tiến trình nền.
# ide-tint --hook : dùng làm hook SessionStart / UserPromptSubmit của Codex (đọc JSON hook ở stdin, không in gì)
import json, os, re, subprocess, sys

# Số sao của ngọc = độ thông minh của model (Artificial Analysis Intelligence Index, benchlm.ai 19/11/2026):
#   7 ≥63 · 6 60-63 · 5 57-60 · 4 53-57 · 3 48-53 · 2 40-48 · 1 <40. Model lạ → số sao theo effort.
MODEL_STARS = {
    "fable52": 7,                                    # 64.6
    "gpt62astra": 6, "neon": 6, "carbon": 6,         # 62.1 · 61.4 · 60.0
    "opus55": 5, "gpt62sol": 5,                      # 59.1 · 57.3
    "gpt61sol": 4, "sonnet55": 4, "hydrogen": 4,     # 54.6 · 54.5 · 53.9
    "argon": 3, "fable51": 3, "fable5": 3,           # 50.4 · 49.2 · 49.6
    "haiku55": 1,                                    # 36.5
}
# mức effort → (số ngọc khi không biết model, màu nhấn)
LEVELS = {
    "low": (1, "F2C230"), "medium": (2, "C98A0B"), "high": (3, "FFD84D"),
    "xhigh": (4, "E0384F"), "max": (5, "2FA8F0"), "ultracode": (7, "D8DEE9"),
}
BALL = "F5A623"
# màu gốc của theme Claude IDE Dragonball: ô ANSI → hex
BASE = {3: "E5B567", 4: "7AA2C9", 5: "C792B8", 6: "7FB8B0", 11: "F0C987", 12: "96BAE0", 13: "D9A9CC", 14: "9ACCC4"}


def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(round(x + (y - x) * t) for x, y in zip(rgb(a), rgb(b)))


def ultracode(transcript):
    # prompt gần nhất của người dùng có chữ ultracode không
    try:
        with open(transcript, "rb") as fh:
            fh.seek(max(0, os.path.getsize(transcript) - 262144))
            lines = fh.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return False
    for line in reversed(lines):
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        msg = obj.get("message") or {}
        if obj.get("type") != "user" or msg.get("role") != "user":
            continue
        content = msg.get("content")
        if isinstance(content, list):
            if any(isinstance(c, dict) and c.get("type") == "tool_result" for c in content):
                continue
            content = " ".join(c.get("text", "") for c in content if isinstance(c, dict))
        if isinstance(content, str) and not content.lstrip().startswith("<"):
            return "ultracode" in content.lower()
    return False


def codex_effort(transcript):
    # effort của lượt gần nhất trong rollout Codex, không có thì lấy model_reasoning_effort trong config.toml
    text = ""
    try:
        with open(transcript, "rb") as fh:
            fh.seek(max(0, os.path.getsize(transcript) - 262144))
            text = fh.read().decode("utf-8", "ignore")
    except (OSError, TypeError):
        pass
    found = re.findall(r'"(?:reasoning_)?effort"\s*:\s*"([a-z]+)"', text)
    if not found:
        try:
            found = re.findall(r'^model_reasoning_effort\s*=\s*"([a-z]+)"', open(os.path.expanduser("~/.codex/config.toml")).read(), re.M)
        except OSError:
            pass
    eff = found[-1] if found else ""
    return {"minimal": "low", "none": "low"}.get(eff, eff)


def model_stars(name):
    key = re.sub(r"[^a-z0-9]", "", (name or "").lower())
    return next((MODEL_STARS[k] for k in sorted(MODEL_STARS, key=len, reverse=True) if k in key), None)


def balls(level, model=None):
    # ngọc rồng n sao: chữ số trong hình tròn đặc, tô cam
    n = model_stars(model) or LEVELS[level][0]
    return f"\033[1;38;2;{';'.join(map(str, rgb(BALL)))}m{'❶❷❸❹❺❻❼'[n - 1]}\033[0m"


def apply(level, sid, agent="claude"):
    import iterm2
    _, accent = LEVELS[level]
    wm = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "art", "saiyan", "wm", f"{agent}-{level}.png")

    async def main(conn):
        app = await iterm2.async_get_app(conn)
        s = app.get_session_by_id(sid)
        if not s:
            return
        p = iterm2.LocalWriteOnlyProfile()
        c = lambda t: iterm2.Color(*t)
        p.set_cursor_color(c(rgb(accent)))
        p.set_link_color(c(rgb(accent)))
        p.set_selection_color(c(mix("0E0E0E", accent, 0.35)))
        p.set_tab_color(c(rgb(accent)))
        p.set_use_tab_color(True)
        for slot, base in BASE.items():
            getattr(p, f"set_ansi_{slot}_color")(c(mix(base, accent, 0.6)))
        if os.path.exists(wm):  # mascot của agent ở mức effort này làm hình mờ góc dưới phải
            p.set_background_image_location(os.path.realpath(wm))
        await s.async_set_profile_properties(p)

    iterm2.run_until_complete(main)


if __name__ == "__main__":
    if sys.argv[1:2] == ["--apply"]:
        apply(*sys.argv[2:5])
        sys.exit(0)
    args = sys.argv[1:]
    hook = args[:1] == ["--hook"]
    if hook:
        try:
            level = codex_effort(json.load(sys.stdin).get("transcript_path"))
        except ValueError:
            level = codex_effort(None)
    else:
        level = (args[0] if args else "").lower()
        if "--transcript" in args and ultracode(args[args.index("--transcript") + 1]):
            level = "ultracode"
    if level not in LEVELS:
        sys.exit(0)
    agent = "codex" if hook else args[args.index("--agent") + 1] if "--agent" in args else "claude"
    if not hook:
        ball = balls(level, args[args.index("--model") + 1] if "--model" in args else None)
        print(f"{level}\t{ball}" if "--with-level" in args else ball, end="")
    sid = os.environ.get("ITERM_SESSION_ID", "").split(":")[-1]
    if not sid:
        sys.exit(0)
    cache = os.path.expanduser(f"~/.cache/ide-tint/{sid}")
    try:
        with open(cache) as fh:
            if fh.read() == f"{agent}:{level}":
                sys.exit(0)
    except OSError:
        pass
    os.makedirs(os.path.dirname(cache), exist_ok=True)
    with open(cache, "w") as fh:
        fh.write(f"{agent}:{level}")
    subprocess.Popen(["uv", "run", "--quiet", "--python", "3.14", "--with", "iterm2", "python", os.path.realpath(__file__),
                      "--apply", level, sid, agent], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
